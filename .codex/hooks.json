{
  "description": "Защита закоммиченных миграций и проверка ESLint фронтенда.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/protect-migrations.py\"",
            "timeout": 10,
            "statusMessage": "Защита закоммиченных миграций"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/frontend-eslint.mjs\"",
            "timeout": 120,
            "statusMessage": "Проверка ESLint фронтенда"
          }
        ]
      }
    ]
  }
}
